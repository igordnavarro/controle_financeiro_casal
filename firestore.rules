rules_version = '2';

// Só os dois e-mails abaixo podem ler e escrever (os mesmos de js/config.js).
// Copie este arquivo inteiro e publique em Firebase → Firestore Database → Regras.
service cloud.firestore {
  match /databases/{database}/documents {
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'igordnavarro@gmail.com',
          'mendes.thathais@gmail.com'
        ];
    }

    match /casas/{casaId} {
      allow read, write: if permitido();
      match /{colecao}/{docId} {
        allow read, write: if permitido();
      }
    }
  }
}
