rules_version = '2';

// Só os dois e-mails abaixo podem ler e escrever. Troque EMAIL_DA_THAIS pelo e-mail Google dela
// (o mesmo que está em js/config.js) e publique em Firebase → Firestore Database → Regras.
service cloud.firestore {
  match /databases/{database}/documents {
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'igordnavarro@gmail.com',
          'email_da_thais@gmail.com'
        ];
    }

    match /casas/{casaId} {
      allow read, write: if permitido();
      match /{colecao}/{docId} {
        allow read, write: if permitido();
      }
    }
  }
}
